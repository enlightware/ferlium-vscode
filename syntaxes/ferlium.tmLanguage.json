{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ferlium",
  "scopeName": "source.ferlium",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-definition" },
    { "include": "#trait-definition" },
    { "include": "#type-alias-definition" },
    { "include": "#type-definition" },
    { "include": "#impl-definition" },
    { "include": "#use-declaration" },
    { "include": "#associated-const" },
    { "include": "#labels" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-call" },
    { "include": "#types" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.ferlium",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.ferlium",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ferlium",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.ferlium",
          "begin": "#\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.begin.ferlium" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.end.ferlium" }
          },
          "patterns": [
            { "include": "#strings" },
            {
              "name": "entity.name.function.attribute.ferlium",
              "match": "\\b(?:r#)?[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "keyword.operator.assignment.ferlium",
              "match": "="
            },
            {
              "name": "punctuation.separator.ferlium",
              "match": "[,()]"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.ferlium",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ferlium",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.ferlium",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.interpolation.begin.ferlium" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.interpolation.end.ferlium" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.ferlium",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ferlium",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.binary.ferlium",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.ferlium",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.ferlium",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ferlium",
          "match": "\\b(if|else|match|for|in|loop|return|break|continue|effects_unsafe|soft_break)\\b"
        },
        {
          "name": "keyword.declaration.ferlium",
          "match": "\\b(pub|fn|let|mut|struct|enum|type|trait|impl|use|const|where)\\b"
        },
        {
          "name": "keyword.operator.logical.ferlium",
          "match": "\\b(and|or|not)\\b|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.cast.ferlium",
          "match": "\\b(as)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ferlium",
          "match": "\\|->|->|=>"
        },
        {
          "name": "keyword.operator.range.ferlium",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.pipe.ferlium",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.ferlium",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.ferlium",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.assignment.ferlium",
          "match": "="
        },
        {
          "name": "keyword.operator.reference.ferlium",
          "match": "&"
        },
        {
          "name": "keyword.operator.arithmetic.ferlium",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.sum-type.ferlium",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.path.ferlium",
          "match": "::"
        },
        {
          "name": "keyword.operator.property.ferlium",
          "match": "@"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.ferlium",
          "match": "[;,]"
        },
        {
          "name": "punctuation.accessor.ferlium",
          "match": "\\."
        },
        {
          "name": "punctuation.type.ferlium",
          "match": ":"
        },
        {
          "name": "punctuation.bracket.ferlium",
          "match": "[(){}\\[\\]]"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(pub\\s+)?(fn)\\s+((?:r#)?[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=<|\\()",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" },
            "2": { "name": "keyword.declaration.ferlium" },
            "3": { "name": "entity.name.function.ferlium" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b((?:r#)?[a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.ferlium" }
          }
        }
      ]
    },
    "trait-definition": {
      "patterns": [
        {
          "match": "\\b(pub\\s+)?(trait)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" },
            "2": { "name": "keyword.declaration.ferlium" },
            "3": { "name": "entity.name.type.trait.ferlium" }
          }
        }
      ]
    },
    "type-alias-definition": {
      "patterns": [
        {
          "match": "\\b(pub\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*|[a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" },
            "2": { "name": "keyword.declaration.ferlium" },
            "3": { "name": "entity.name.type.ferlium" }
          }
        }
      ]
    },
    "type-definition": {
      "patterns": [
        {
          "match": "\\b(pub\\s+)?(struct|enum)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" },
            "2": { "name": "keyword.declaration.ferlium" },
            "3": { "name": "entity.name.type.ferlium" }
          }
        }
      ]
    },
    "impl-definition": {
      "patterns": [
        {
          "match": "\\b(impl)\\s+(?:<[^>{}\\n]*>\\s*)?([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" },
            "2": { "name": "entity.name.type.ferlium" }
          }
        }
      ]
    },
    "use-declaration": {
      "patterns": [
        {
          "match": "\\b(use)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" }
          }
        }
      ]
    },
    "associated-const": {
      "patterns": [
        {
          "match": "\\b(const)\\s+((?:r#)?[A-Z_a-z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ferlium" },
            "2": { "name": "variable.other.constant.ferlium" }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.ferlium",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ferlium",
          "match": "\\b(int|float|bool|string|unit|hash)\\b"
        },
        {
          "name": "entity.name.type.ferlium",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ferlium",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.ferlium",
          "match": "\\b(Some|None)\\b"
        },
        {
          "name": "constant.language.ordering.ferlium",
          "match": "\\b(Less|Equal|Greater)\\b"
        },
        {
          "name": "constant.language.control-flow.ferlium",
          "match": "\\b(Continue|Break)\\b"
        },
        {
          "name": "constant.language.placeholder.ferlium",
          "match": "\\b_\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.ferlium",
          "match": "\\b(?:r#)?[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}

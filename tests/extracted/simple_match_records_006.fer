for l in [false, true] {
    for r in [false, true] {
        let v = match { x: l, y: r } {
            { y: true,  x: true  } => 1,
            { y: false, x: true  } => 2,
            { y: true,  x: false } => 3,
            { y: false, x: false } => 4,
        };
